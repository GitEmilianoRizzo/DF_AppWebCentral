# ============================================
# DF Group - Variables de Entorno
# Copiar a .env y configurar valores
# ============================================

# SQL Server
# Para SQL Server contenedor (demo):
SA_PASSWORD=YourStrong@Passw0rd

# Para SQL Server externo (produccion):
# DB_CONNECTION_STRING=Server=tu-servidor.database.windows.net;Database=DF_DTW_APP;User Id=admin;Password=TuPassword;TrustServerCertificate=True

# Connection string completo (alternativa)
DB_CONNECTION_STRING=Server=sqlserver;Database=DF_DTW_APP;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True

# API Configuration
ASPNETCORE_ENVIRONMENT=Development

# Frontend
VITE_API_URL=/api/v1

# Logging
LOG_LEVEL=Information
